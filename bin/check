#!/usr/bin/env python3
"""Check the plugin's manifests, hook, skills and prose."""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
RULES_FILE = root / "skills/plain-writing/SKILL.md"
RULES_HEADING = "## How to write"


def check_manifests():
    errors = []
    parsed = {}
    for name in ["plugin.json", "marketplace.json"]:
        path = root / ".claude-plugin" / name
        try:
            parsed[name] = json.loads(path.read_text())
        except (OSError, ValueError) as e:
            errors.append(f"{path.relative_to(root)}: {e}")
    if errors:
        return errors
    plugin, market = parsed["plugin.json"], parsed["marketplace.json"]
    if plugin["name"] not in [p["name"] for p in market["plugins"]]:
        errors.append("marketplace.json doesn't list the plugin")
    return errors


def check_hook(rules):
    hooks = json.loads((root / "hooks/hooks.json").read_text())
    command = hooks["hooks"]["SessionStart"][0]["hooks"][0]["command"]
    target = re.search(r"\$\{CLAUDE_PLUGIN_ROOT\}/([^\"]+)", command).group(1)
    if not (root / target).is_file():
        return [f"the SessionStart hook reads a missing file: {target}"]
    env = {**os.environ, "CLAUDE_PLUGIN_ROOT": str(root)}
    printed = subprocess.run(command, shell=True, env=env, capture_output=True, text=True).stdout
    if [line for line in printed.splitlines() if line.strip()] != [RULES_HEADING] + rules:
        return ["the SessionStart hook doesn't print the rules and only the rules"]
    return []


def skill_files():
    return sorted((root / "skills").glob("*/SKILL.md"))


def check_frontmatter():
    errors = []
    for path in skill_files():
        skill = path.parent.name
        front = re.match(r"---\n(.*?)\n---\n", path.read_text(), re.S)
        if not front:
            errors.append(f"{skill}: SKILL.md has no frontmatter")
            continue
        fields = dict(line.split(": ", 1) for line in front.group(1).splitlines() if ": " in line)
        if fields.get("name") != skill:
            errors.append(f"{skill}: frontmatter name is {fields.get('name')!r}")
        if not fields.get("description"):
            errors.append(f"{skill}: frontmatter has no description")
    return errors


def rule_lines():
    sections = RULES_FILE.read_text().split("\n## ")
    body = next(s for s in sections if s.startswith(RULES_HEADING[3:] + "\n"))
    return [line for line in body.splitlines()[1:] if line.strip()]


def check_one_copy_of_the_rules(rules):
    errors = []
    for path in prose_files():
        if path == RULES_FILE:
            continue
        lines = set(path.read_text().splitlines())
        for rule in rules:
            if rule in lines:
                errors.append(f"{path.relative_to(root)}: copies a rule: {rule[:60]}")
    for skill in ["review", "rewrite"]:
        if "`plain-writing` skill" not in (root / "skills" / skill / "SKILL.md").read_text():
            errors.append(f"{skill}: doesn't load the plain-writing skill")
    return errors


def banned_words(rules):
    text = "\n".join(rules)
    written_only = re.search(r'written-only words like (.*?), and "names"', text)
    filler = re.search(r"filler like (.*?) unless", text)
    pointers = re.search(r"Don't describe the document or point around it\. Delete (.*?)\.", text)
    if not written_only or not filler or not pointers:
        return None
    filler_words = re.findall(r'"([^"]+)"', filler.group(1))
    words_before_the_exception = filler_words[:-1]
    pointer_words = re.findall(r'"([^"]+)"', pointers.group(1))
    return written_only.group(1).split(", ") + words_before_the_exception + pointer_words


def prose_files():
    paths = [root / "README.md", root / "bin/check", root / "hooks/hooks.json"]
    manifests = [root / ".claude-plugin/plugin.json", root / ".claude-plugin/marketplace.json"]
    return paths + manifests + skill_files() + sorted((root / "changelog.d").glob("*.md"))


def prose_lines(path, rules):
    for number, line in enumerate(path.read_text().splitlines(), 1):
        if line in rules:
            continue
        if line.startswith("|"):
            line = line.split("|", 2)[2]
        yield number, line


def check_own_prose(rules):
    words = banned_words(rules)
    if words is None:
        return ["plain-writing: can't find the banned word lists"]
    banned = re.compile(r"\b(" + "|".join(map(re.escape, words)) + r")\w*", re.I)
    errors = []
    for path in prose_files():
        name = path.relative_to(root)
        for number, line in prose_lines(path, rules):
            for match in banned.finditer(line):
                errors.append(f"{name}:{number}: the rules ban {match.group(0)!r}")
            if path.suffix == ".md" and re.match(r"#+ .*: ", line):
                errors.append(f"{name}:{number}: colon subtitle in a heading")
            if path.suffix == ".json" and re.search(r'"description": "[^"]*: ', line):
                errors.append(f"{name}:{number}: colon subtitle in a description")
    return errors


def main():
    rules = rule_lines()
    errors = check_manifests() + check_hook(rules) + check_frontmatter()
    errors += check_one_copy_of_the_rules(rules) + check_own_prose(rules)
    for e in errors:
        print(e)
    print("ok" if not errors else f"{len(errors)} problems")
    return 1 if errors else 0


sys.exit(main())
